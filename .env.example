# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Neon's pooled Postgres connection string (sslmode=require). Required.
DATABASE_URL=
# API key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Daily cap on receipt reads for one chat, Asia/Singapore day. Default shown; 0 refuses every read.
RECEIPT_READS_PER_CHAT_PER_DAY=40
# Daily cap on receipt reads across all chats, Asia/Singapore day. Default shown; 0 refuses every read.
RECEIPT_READS_PER_DAY=400
